# Copy to .env on the server (never commit it). Single quotes keep $ characters literal.
DOMAIN=cubbie-tesseract.duckdns.org

# Amazon RDS (Part 1, step 6)
DATABASE_URL='postgresql://tesseract:PASSWORD@ENDPOINT.us-west-2.rds.amazonaws.com:5432/tesseract?sslmode=require'

# Tesseract: Discord bot and Claude
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# Cubbie sync Skill key (openssl rand -hex 24); the same value goes into Cubbie as CUBBIE_DASHBOARD_API_KEY
CUBBIE_INGEST_KEY=

# Dashboard login (Caddy). Make the hash with:
#   docker compose run --rm caddy caddy hash-password --plaintext 'your-password'
DASHBOARD_USER=team
DASHBOARD_PASSWORD_HASH=''

# Railway / Render instead of Caddy: the app asks for this login itself (leave empty when using Caddy)
DASHBOARD_PASSWORD=
