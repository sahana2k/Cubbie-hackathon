# Free HTTPS certificate for $DOMAIN, plus a login in front of the dashboard.
{$DOMAIN} {
	encode gzip

	# Cubbie's sync Skill calls this server-to-server with its own key, so it skips the login.
	handle /api/ingest/* {
		reverse_proxy app:8787
	}

	handle {
		basic_auth {
			{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
		}
		reverse_proxy app:8787
	}
}
