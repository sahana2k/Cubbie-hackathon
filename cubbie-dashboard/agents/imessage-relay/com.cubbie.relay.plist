<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ and run: launchctl load ~/Library/LaunchAgents/com.cubbie.relay.plist
     Replace the node and repo paths below with yours (which node; pwd). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cubbie.relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/cubbie-dashboard/agents/imessage-relay/dist/index.js</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/cubbie-relay.log</string>
  <key>StandardErrorPath</key><string>/tmp/cubbie-relay.err</string>
</dict>
</plist>
