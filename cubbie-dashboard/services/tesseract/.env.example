# ── Discord ──────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (General Information page)
DISCORD_CLIENT_ID=
# Your hackathon server's ID (right-click server icon → Copy Server ID; needs Developer Mode on)
# Used to register slash commands instantly to this server and by `npm run setup-server`.
DISCORD_GUILD_ID=

# ── Claude ───────────────────────────────────────────────
# From https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Model for agents and @mention answers (reasoning-heavy work)
CLAUDE_MODEL=claude-sonnet-5-5
# Cheap, fast model for routing and passive message scanning
CLAUDE_FAST_MODEL=claude-haiku-5-5

# ── App ──────────────────────────────────────────────────
# Default timezone for new projects (IANA name)
DEFAULT_TIMEZONE=America/Phoenix
# SQLite database file (on Railway/Render mount a volume and point this into it)
DATABASE_PATH=./data/mergemates.db
# How often the reminder worker runs, in seconds
SCHEDULER_INTERVAL_SECONDS=60
# Log level: debug | info | warn | error
LOG_LEVEL=info
