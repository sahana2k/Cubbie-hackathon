{
  "name": "@cubbie/tesseract",
  "version": "1.0.0",
  "description": "MergeMates \u2014 the AI project manager inside your Discord group chat, powered by Claude",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "register-commands": "tsx src/scripts/registerCommands.ts",
    "setup-server": "tsx src/scripts/setupServer.ts",
    "dashboard": "node dist/dashboard.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vite": "^8.0.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
